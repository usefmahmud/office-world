# Copy to .env — never commit the real values.
# Bind to loopback by default: no public exposure without explicit owner approval.
BIND_HOST=127.0.0.1
WEB_PORT=8095

# Engine
TICK=2
# Simulated seconds one tick stands for (WORLD-9). 60 = one simulated minute per tick,
# so the 09:00-18:00 day (540 ticks) runs in ~18 minutes of wall time at TICK=2.
WORLD_SIM_SECONDS_PER_TICK=60
WORLD_SEED=7
# Optional: when set, POST /api/world/events and /api/world/tick require X-World-Token.
# WORLD_TOKEN=
